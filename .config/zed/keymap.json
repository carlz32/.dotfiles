[
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            "j k": ["workspace::SendKeystrokes", "escape"],
            "ctrl-h": "vim::DeleteLeft"
        }
    },
    {
        "context": "Editor && vim_mode == normal && vim_operator == none && !VimWaiting",
        "bindings": {
            "tab": "pane::ActivateNextItem",
            "shift-tab": "pane::ActivatePrevItem"
        }
    },
    {
        "context": "Editor && VimControl && !VimWaiting && !menu",
        "bindings": {
            "g e": "vim::PreviousSubwordEnd"
        }
    },
    {
        "context": "ProjectPanel || CollabPanel || OutlinePanel || AssistantPanel || VimControl || EmptyPane || SharedScreen || MarkdownPreview || KeyContextView",
        "bindings": {
            "ctrl-s h": ["workspace::ActivatePaneInDirection", "Left"],
            "ctrl-s l": ["workspace::ActivatePaneInDirection", "Right"],
            "ctrl-s k": ["workspace::ActivatePaneInDirection", "Up"],
            "ctrl-s j": ["workspace::ActivatePaneInDirection", "Down"],
            "ctrl-s v": "pane::SplitVertical",
            "ctrl-s s": "pane::SplitHorizontal",
            "ctrl-s right": ["vim::ResizePane", "Widen"],
            "ctrl-s left": ["vim::ResizePane", "Narrow"],
            "ctrl-s down": ["vim::ResizePane", "Shorten"],
            "ctrl-s up": ["vim::ResizePane", "Lengthen"]
        }
    },
    {
        "context": "Dock",
        "bindings": {
            "ctrl-s h": ["workspace::ActivatePaneInDirection", "Left"],
            "ctrl-s l": ["workspace::ActivatePaneInDirection", "Right"],
            "ctrl-s k": ["workspace::ActivatePaneInDirection", "Up"],
            "ctrl-s j": ["workspace::ActivatePaneInDirection", "Down"]
        }
    }
]
