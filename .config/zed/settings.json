{
    "theme": {
        "mode": "system",
        "light": "Gruvbox Light",
        "dark": "Gruvbox Dark"
    },
    "experimental.theme_overrides": {
        "background.appearance": "transparent",
        "background": "#00000080",
        "editor.background": "#00000020",
        "editor.gutter.background": "#00000020",
        "editor.active_line.background": "#00000020",
        "editor.subheader.background": "#00000000",
        "editor.highlighted_line.background": "#00000030",
        "ghost_element.background": "#00000000",
        "ghost_element.active": "#00000080",
        "surface.background": "#00000000",
        "elevated_surface.background": "#000000",
        "terminal.background": "#00000030",
        "status_bar.background": "#00000040",
        "title_bar.background": "#00000030",
        "toolbar.background": "#00000000",
        "tab_bar.background": "#00000020",
        "tab.active_background": "#00000020",
        "tab.inactive_background": "#00000000",
        "panel.background": "#00000000",
        "border.variant": "#00000000",
        "scrollbar.track.border": "#00000000"
    },
    "features": {
        "edit_prediction_provider": "zed"
    },
    "assistant": {
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-3-7-sonnet-latest"
        },
        "version": "2"
    },
    "enable_experimental_features": true,
    "ui_font_size": 18,
    "ui_font_family": "SF Mono",
    "buffer_font_size": 24,
    "buffer_font_family": "FantasqueSansM Nerd Font",
    "confirm_quit": true,
    "format_on_save": "on",
    "autosave": "on_focus_change",
    "vim_mode": true,
    "tabs": {
        "close_position": "left",
        "git_status": true
    },
    "always_treat_brackets_as_autoclosed": true,
    "relative_line_numbers": true,
    "vertical_scroll_margin": 13,
    "terminal": {
        "font_family": "FantasqueSansM Nerd Font",
        "font_size": 20
    },
    "vim": {
        "use_system_clipboard": "always",
        "use_multiline_find": true
    },
    "prettier": {
        "allowed": true,
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true
    }
}
