{
    "theme": {
        "mode": "system",
        "light": "Gruvbox Light",
        "dark": "Gruvbox Dark"
    },
    "features": {
        "edit_prediction_provider": "zed"
    },
    "ui_font_size": 18,
    "ui_font_family": "SF Mono",
    "buffer_font_size": 24,
    "buffer_font_family": "LXGW WenKai Mono",
    "confirm_quit": true,
    "format_on_save": "on",
    "autosave": "on_focus_change",
    "vim_mode": true,
    "tabs": {
        "close_position": "left",
        "git_status": true
    },
    "always_treat_brackets_as_autoclosed": true,
    "relative_line_numbers": "enabled",
    "vertical_scroll_margin": 13,
    "terminal": {
        "font_family": "FantasqueSansM Nerd Font",
        "font_size": 20
    },
    "vim": {
        "use_system_clipboard": "always"
    },
    "prettier": {
        "allowed": true,
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true
    },
    "agent": {
        "play_sound_when_agent_done": true,
        "always_allow_tool_actions": true,
        "default_model": {
            "provider": "ChatAnyWhere",
            "model": "gpt-4o-mini"
        }
    },
    "language_models": {
        "openai_compatible": {
            // Using Together AI as an example
            "ChatAnyWhere": {
                "api_url": "https://api.chatanywhere.tech",
                "available_models": [
                    {
                        "name": "gpt-4o-mini",
                        "display_name": "GPT",
                        "max_tokens": 64000
                    }
                ]
            }
        }
    }
}
