{
    "edit_predictions": {
        "provider": "copilot",
    },
    "agent_servers": {
        "kilo": {
            "type": "registry",
        },
    },
    "proxy": "",
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark",
    },
    "ui_font_size": 18,
    "ui_font_family": "SF Mono",
    "buffer_font_size": 24,
    "buffer_font_family": "IoskeleyMono Nerd Font",
    "confirm_quit": true,
    "format_on_save": "on",
    "autosave": "on_focus_change",
    "vim_mode": true,
    "tabs": {
        "close_position": "left",
        "git_status": true,
    },
    "always_treat_brackets_as_autoclosed": true,
    "relative_line_numbers": "enabled",
    "vertical_scroll_margin": 13,
    "terminal": {
        "font_family": "IoskeleyMono Nerd Font",
        "font_size": 20,
    },
    "vim": {
        "use_system_clipboard": "always",
    },
    "prettier": {
        "allowed": true,
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true,
    },
    "agent": {},
    "language_models": {},
}
